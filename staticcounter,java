class Employee {
    String name;
    double salary;
    static int totalEmployees = 0; // static counter

    // Constructor
    Employee(String name, double salary) {
        this.name = name;
        this.salary = salary;
        totalEmployees++; // increment counter
    }

    void displayDetails() {
        System.out.println("Name: " + name + ", Salary: " + salary);
    }

    static void displayTotalEmployees() {
        System.out.println("Total Employees: " + totalEmployees);
    }
}

public class EmployeeMain {
    public static void main(String[] args) {
        Employee e1 = new Employee("Riya", 50000);
        Employee e2 = new Employee("Ravi", 60000);
        Employee e3 = new Employee("Anita", 70000);

        e1.displayDetails();
        e2.displayDetails();
        e3.displayDetails();

        Employee.displayTotalEmployees();
    }
}

